# 复制成 .env 后填写（.env 已在 .gitignore 里，不会被提交）。只有在本地手动运行时才需要；
# GitHub Action 用仓库 Settings → Secrets and variables 里的同名变量，Cloudflare Worker 用 Worker 自己的设置。

# Telegram bot 的 token（@BotFather 给的那串）
TELEGRAM_BOT_TOKEN=
# 你和 bot 对话的 chat ID（只接受这个 chat 的按钮点击）
TELEGRAM_CHAT_ID=
# （可选）团队群的 chat ID。配置了 share_to_group 的主题会抄送一份到群里；不填就只发私信
TELEGRAM_TEAM_GROUP_ID=

# 方案 B（直接调用 AI 接口）用到哪家就填哪家
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# 设为 1 时只打印、不真的发 Telegram（本地试跑用）
INTEL_DRY_RUN=1
# 「今天」按哪个时区算，例如 Asia/Shanghai、Europe/London。不填就是 UTC
INTEL_TZ=
# 日志详细程度：DEBUG / INFO / WARNING
INTEL_LOG_LEVEL=INFO
